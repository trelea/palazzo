{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "shadcn": {
      "type": "local",
      "command": ["npx", "shadcn@latest", "mcp"],
      "enabled": true
    },
    "magicuidesign-mcp": {
      "type": "local",
      "command": ["npx", "-y", "@magicuidesign/mcp@latest"],
      "enabled": true
    },
    "aceternityui": {
      "type": "local",
      "command": ["npx", "aceternityui-mcp"],
      "enabled": true
    }
  }
}
